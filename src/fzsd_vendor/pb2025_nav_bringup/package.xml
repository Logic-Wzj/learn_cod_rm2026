<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pb2025_nav_bringup</name>
  <version>1.2.0</version>
  <description>pb2025_nav_bringup (vendored: 仅保留本仓库仿真需要的资源：map/config 等)</description>
  <maintainer email="lihanchen2004@163.com">Lihan Chen</maintainer>
  <license>Apache-2.0</license>
  <author email="lihanchen2004@163.com">Lihan Chen</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 说明：本仓库只用它的 map/config/rviz 资源，不跑它自带的实车 bringup。
       故去掉了 navigation2 / nav2_common / launch_ros / 各 fzsd 实车包的依赖，
       让它成为一个纯粹的"资源包"，编它不需要任何 nav2/fzsd 环境。 -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
