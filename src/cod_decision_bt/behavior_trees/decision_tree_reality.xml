<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <ReactiveFallback name="MainDecision">
      <!-- 游戏未进行：停车 -->
      <Sequence name="IdleNotRunning">
        <Inverter name="NotRunning">
          <IsGameRunning game_status_topic="${game_status_topic}"/>
        </Inverter>
        <StopRobot cmd_vel_topic="${stop_cmd_vel_topic}"/>
      </Sequence>

      <!-- 血量过低：回补给点 -->
      <Sequence name="RetreatToSupply">
        <IsHpLow threshold="${hp_threshold}" robot_status_topic="${robot_status_topic}"/>
        <SetRetreatGoal x="${retreat_x}" y="${retreat_y}" frame_id="${goal_frame}"/>
        <NavigateToPose goal="{goal}" server_name="${navigate_server_name}"/>
      </Sequence>

      <!-- 正常运行：巡航 -->
      <Sequence name="Patrol">
        <PatrolNextWaypoint waypoints="${patrol_waypoints}" use_spawn_pose="${patrol_use_spawn_pose}" frame_id="${goal_frame}"/>
        <NavigateToPose goal="{goal}" server_name="${navigate_server_name}"/>
      </Sequence>
    </ReactiveFallback>
  </BehaviorTree>
</root>
